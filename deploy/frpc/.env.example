# 客户端管理员。仅在认证文件不存在时必须设置密码。
FRP_ADMIN_USERNAME=admin
FRP_ADMIN_PASSWORD=replace-with-a-long-password
# Docker secrets 可用文件替代直接值；同时设置时文件优先。
# FRP_ADMIN_PASSWORD_FILE=/run/secrets/frp_admin_password

# 与 frps 的 FRP_AUTH_TOKEN 保持一致。
FRP_AUTH_TOKEN=replace-with-a-random-token
# FRP_AUTH_TOKEN_FILE=/run/secrets/frp_auth_token

# 仅在首次生成或显式重建配置时使用。
FRP_LOG_LEVEL=info
FRP_LOG_MAX_DAYS=7
FRP_REGENERATE_CONFIG=0

# 公网 frps 地址和端口
FRP_SERVER_ADDR=your-server.example.com
FRP_SERVER_PORT=7000

# 宿主机发布端口
FRPC_DASHBOARD_PORT=7400

# 默认禁止修改 WebServer 网络字段。
FRP_ALLOW_DASHBOARD_NETWORK_CHANGES=0
